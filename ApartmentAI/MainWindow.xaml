<Window x:Class="ApartmentAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApartmentForm" Height="500" Width="800" Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <GroupBox Header="Apartment Information" Padding="10" Margin="0,0,0,20" BorderBrush="Gray">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Apartment No:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"/>
                    <TextBox x:Name="txtAptNo" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

                    <TextBlock Text="Floor:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,0,10"/>
                    <TextBox x:Name="txtFloor" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

                    <CheckBox x:Name="chkOccupied" Content="Is Occupied" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"/>
                </Grid>
            </GroupBox>

            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnAdd" Content="Add" Click="BtnAdd_Click" Grid.Row="0" Grid.Column="0" Height="35" Margin="0,0,5,10" 
                        Background="LightGreen" FontWeight="Bold" VerticalAlignment="Bottom"/>

                <Button x:Name="btnDelete" Content="Delete" Click="BtnDelete_Click" Grid.Row="0" Grid.Column="1" Height="35" Margin="5,0,0,10" 
                        Background="Red" Foreground="White" FontWeight="Bold"/>

                <Button x:Name="btnUpdate" Content="Update"  Click="BtnUpdate_Click" Grid.Row="1" Grid.Column="0" Height="35" Margin="0,0,5,0" 
                        Background="LightBlue"/>

                <Button x:Name="btnClear" Content="Clear" Click="BtnClear_Click" Grid.Row="1" Grid.Column="1" Height="35" Margin="5,0,0,0" 
                        Background="White"/>

            </Grid>


            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Tenant Name" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,10"/>
                <TextBox x:Name="txtTenantName" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,0,10" TextChanged="txtTenantName_TextChanged"/>

                <TextBlock Text="Phone" VerticalAlignment="Center" Grid.Row="1"/>
                <TextBox x:Name="txtPhone" Grid.Row="1" Grid.Column="1" Height="25" TextChanged="txtPhone_TextChanged"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnPayment" 
            Content="Payment" 
            Click="BtnPayment_Click" 
            Height="30" Margin="0,0,5,0" Background="WhiteSmoke"/>

                <Button x:Name="btnAddTenant" 
            Content="Add" 
            Grid.Column="1" 
            Click="BtnAddTenant_Click" 
            Height="30" Margin="5,0,0,0" Background="WhiteSmoke"/>
                <Button x:Name="btnVacate"
            Content="Vacate"
            Margin="85,44,0,-28"
            Click="btnVacate_Click"
            Background="Lavender" Grid.Column="1"/>
            </Grid>
        </StackPanel>

        <DataGrid x:Name="dgApartments"  SelectionChanged="DgApartments_SelectionChanged" Grid.Column="1" Background="DarkGray" BorderBrush="Black" BorderThickness="1" 
                  AutoGenerateColumns="True">
        </DataGrid>

    </Grid>
</Window>