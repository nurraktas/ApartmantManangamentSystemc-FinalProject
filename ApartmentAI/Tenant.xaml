<Window x:Class="ApartmentAI.TenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenant Management" Height="537" Width="850" 
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,15,0" BorderBrush="#DDDDDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="TENANT INFORMATION" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

                <TextBlock Text="Full Name:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFullName" Height="35" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

                <TextBlock Text="Phone:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPhone" Height="35" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

                <TextBlock Text="Apartment:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbApartments" Height="35" Margin="0,0,0,20" 
                          DisplayMemberPath="ApartmentNo" SelectedValuePath="Id" Padding="5"/>

                <StackPanel>
                    <Button x:Name="btnAdd" Content="Add" Height="40" Margin="0,0,0,10"
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="btnAdd_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnUpdate" Content="Update" Height="40" Margin="0,0,0,10"
                            Background="#2196F3" Foreground="White" FontWeight="Bold" Click="btnUpdate_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnDelete" Content="Delete" Height="40" Margin="0,0,0,10"
                            Background="#F44336" Foreground="White" FontWeight="Bold" Click="btnDelete_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnClear" Content="Clear" Height="40" 
                            Background="#FF9800" Foreground="White" FontWeight="Bold" Click="btnClear_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgTenants" Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionChanged="dgTenants_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110"/>
                <DataGridTextColumn Header="Apertment No" Binding="{Binding ApartmentNo}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>