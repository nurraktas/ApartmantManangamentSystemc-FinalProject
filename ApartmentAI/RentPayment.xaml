<Window x:Class="ApartmentAI.RentPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rent Payment Transactions" Height="500" Width="850" 
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,15,0" BorderBrush="#DDDDDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Add New Payment" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

                <TextBlock Text="Tenant:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbTenants" Height="35" Margin="0,0,0,15" 
                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          Padding="5"/>

                <TextBlock Text="Amount (₺):" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtAmount" Height="35" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

                <TextBlock Text="Payment Date:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <DatePicker x:Name="dtpPaymentDate" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <CheckBox x:Name="chkIsPaid" Content="Mark Is Paid" FontSize="14" Margin="0,5,0,20"/>

                <Button x:Name="btnAddPayment" Content="Add  Payment" Height="40" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" 
                        Click="btnAddPayment_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgvPayments" Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Tenant" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Apartment" Binding="{Binding ApartmentNo}" Width="60"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C2}" Width="80"/>
                    <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy}" Width="90"/>

                    <DataGridCheckBoxColumn Header="Is Paid?" Binding="{Binding IsPaid}" Width="80"/>

                </DataGrid.Columns>
            </DataGrid>

            <Button x:Name="btnMarkAsPaid" Grid.Row="1" Content="Mark selected as 'Paid'" Height="40" Margin="0,15,0,0"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                    Click="btnMarkAsPaid_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>